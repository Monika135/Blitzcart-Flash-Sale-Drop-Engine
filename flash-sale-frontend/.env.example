# Set to false once your real backend is ready
VITE_USE_MOCK=true

# Your backend's base API URL (only used when VITE_USE_MOCK=false)
VITE_API_URL=http://localhost:8000/api

# Razorpay public key used by the checkout page when the backend returns
# a Razorpay order id.
VITE_RAZORPAY_KEY_ID=rzp_test_your_public_key

# Optional callback URL if your backend hands Razorpay a hosted return
# location after payment.
VITE_RAZORPAY_CALLBACK_URL=http://localhost:5173/checkout

# SKU of the product being sold in this drop (matches the Product.sku
# you loaded with `python manage.py init_stock <sku>` on the backend)
VITE_PRODUCT_SKU=AJ1-BRED-10
